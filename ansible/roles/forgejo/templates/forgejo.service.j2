[Unit]
Description=Forgejo
After=network.target

[Service]
Type=simple
User={{ forgejo_user }}
Group={{ forgejo_user }}
WorkingDirectory={{ forgejo_work_dir }}
ExecStart=/usr/local/bin/forgejo web --config {{ forgejo_config }}
Restart=always
RestartSec=2s
Environment=USER={{ forgejo_user }} HOME={{ forgejo_home }} FORGEJO_WORK_DIR={{ forgejo_work_dir }}

[Install]
WantedBy=multi-user.target
