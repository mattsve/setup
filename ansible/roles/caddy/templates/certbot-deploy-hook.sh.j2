#!/bin/sh
# Certbot runs every script in renewal-hooks/deploy/ after a successful
# renewal. This refreshes caddy's local, readable copy of the cert/key and
# restarts it to pick up the new material.
set -e

install -o caddy -g caddy -m 0644 "{{ caddy_letsencrypt_dir }}/fullchain.pem" "{{ caddy_cert_dir }}/fullchain.pem"
install -o caddy -g caddy -m 0640 "{{ caddy_letsencrypt_dir }}/privkey.pem" "{{ caddy_cert_dir }}/privkey.pem"
systemctl restart {{ caddy_service }}
